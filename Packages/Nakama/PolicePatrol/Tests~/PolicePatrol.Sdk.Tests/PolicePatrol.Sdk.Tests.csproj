<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;xUnit1031;SYSLIB0050</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Farsi/Runtime/**/*.cs" Exclude="../../../Farsi/Runtime/Unity/**/*.cs" LinkBase="Core" />
    <Compile Include="../../Runtime/**/*.cs" Exclude="../../Runtime/Unity/**/*.cs;../../Runtime/Addressables/**/*.cs" LinkBase="Runtime" />
    <Compile Include="../../Runtime/Unity/Stats/IStatCard.cs;../../Runtime/Unity/Stats/IGoalCard.cs;../../Runtime/Unity/Stats/GoalCardCondition.cs;../../Runtime/Unity/Stats/GoalValueType.cs" LinkBase="Linked" />
    <Compile Include="../../Editor/Store/MyketGradle.cs;../../Editor/StatCards/StatCardJson.cs;../../Editor/ShopCards/ShopCardRow.cs;../../Editor/ShopCards/ShopCardSyncResult.cs" LinkBase="LinkedEditor" />
    <Compile Include="*.cs;Legacy/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NakamaClient" Version="3.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
  </ItemGroup>

</Project>
