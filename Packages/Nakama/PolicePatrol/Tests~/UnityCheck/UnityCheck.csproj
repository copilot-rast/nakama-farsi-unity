<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;SYSLIB0050;CS0649;CS0219;CS0168</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_5_3_OR_NEWER;UNITY_2021_2_OR_NEWER;UNITY_EDITOR;POLICEPATROL_ADDRESSABLES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Farsi/Runtime/**/*.cs" LinkBase="CoreRuntime" />
    <Compile Include="../../../Farsi/Editor/**/*.cs" LinkBase="CoreEditor" />
    <Compile Include="../../../Samples~/QuickStart/*.cs;../../../Samples~/Payments/*.cs" LinkBase="CoreSamples" />
    <Compile Include="../../Runtime/**/*.cs" LinkBase="Runtime" />
    <Compile Include="../../Editor/**/*.cs" LinkBase="Editor" />
    <Compile Include="../../../Samples~/PolicePatrol*/**/*.cs" LinkBase="Samples" />
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="Guide/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NakamaClient" Version="3.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
