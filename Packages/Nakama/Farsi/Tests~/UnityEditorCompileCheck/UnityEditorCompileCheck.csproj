<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_5_3_OR_NEWER;UNITY_2022_3_OR_NEWER;UNITY_EDITOR;UNITY_ANDROID</DefineConstants>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0414;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/**/*.cs" LinkBase="Farsi" />
    <Compile Include="../../Editor/**/*.cs" LinkBase="Editor" />
    <Compile Include="../../../Runtime/*.cs" LinkBase="Nakama" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" IncludeAssets="compile" />
    <PackageReference Include="NakamaClient" Version="3.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
